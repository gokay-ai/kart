---
import type { GetStaticPaths } from 'astro';
import BatteryCharging from '@lucide/astro/icons/battery-charging';
import CardSim from '@lucide/astro/icons/card-sim';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import Copy from '@lucide/astro/icons/copy';
import Headphones from '@lucide/astro/icons/headphones';
import Mail from '@lucide/astro/icons/mail';
import Phone from '@lucide/astro/icons/phone';
import QrCode from '@lucide/astro/icons/qr-code';
import ReceiptText from '@lucide/astro/icons/receipt-text';
import Share2 from '@lucide/astro/icons/share-2';
import UserRoundPlus from '@lucide/astro/icons/user-round-plus';
import X from '@lucide/astro/icons/x';
import { siInstagram, siWhatsapp } from 'simple-icons';
import Card from '../../components/Card.astro';
import Emblem from '../../components/Emblem.astro';
import Monogram from '../../components/Monogram.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import StorePanel from '../../components/StorePanel.astro';
import { emailOf, fullName, people, phoneOf, store, type Person, type Service } from '../../data/team';
import Base from '../../layouts/Base.astro';
import { rootPrefix } from '../../lib/site';

export const getStaticPaths = (() =>
  people.map((person) => ({ params: { slug: person.slug }, props: { person } }))) satisfies GetStaticPaths;

interface Props {
  person: Person;
}

const { person } = Astro.props;
const root = rootPrefix(Astro.url.pathname);
const name = fullName(person);
const mates = people.filter((p) => p.slug !== person.slug);

const phone = phoneOf(person);
const email = emailOf(person);
const whatsapp = person.whatsapp ?? phone;
const instagram = person.instagram ?? store.instagram;
const waText = encodeURIComponent('Merhaba, dijital kartvizitinizden ulaşıyorum.');

interface Action {
  key: 'call' | 'whatsapp' | 'mail' | 'instagram';
  label: string;
  href?: string;
  external?: boolean;
}

const actions: Action[] = [
  { key: 'call', label: 'Ara', href: phone ? `tel:${phone}` : undefined },
  {
    key: 'whatsapp',
    label: 'WhatsApp',
    href: whatsapp ? `https://wa.me/${whatsapp.replace(/\D/g, '')}?text=${waText}` : undefined,
    external: true,
  },
  { key: 'mail', label: 'E-posta', href: email ? `mailto:${email}` : undefined },
  {
    key: 'instagram',
    label: 'Instagram',
    href: instagram ? `https://www.instagram.com/${instagram}/` : undefined,
    external: true,
  },
];

const serviceIcons: Record<Service['icon'], typeof Phone> = {
  repair: BatteryCharging,
  sim: CardSim,
  account: ReceiptText,
  accessory: Headphones,
};
---

<Base
  title={`${name} · ${store.name}`}
  description={`${name}, ${person.title}. ${store.name}, ${store.district}. Kartviziti açın, tek dokunuşla rehberinize kaydedin.`}
  ogImage={`og/${person.slug}.jpg`}
>
  <header class="topbar">
    <a class="topbar__brand" href={root} aria-label={`${store.name} ekibi`}>
      <Emblem />
      <span>{store.mall}</span>
    </a>
    <div class="topbar__actions">
      <button class="icon-btn" type="button" data-open-sheet aria-label="QR kodu göster">
        <QrCode size={19} stroke-width={2} />
      </button>
      <button class="icon-btn" type="button" data-share aria-label="Kartı paylaş">
        <Share2 size={19} stroke-width={2} />
      </button>
    </div>
  </header>

  <main class="page" data-share-title={`${name} · ${store.name}`} data-share-text={`${name}, ${person.title}`}>
    <section class="hero">
      <Card person={person} />

      <p class="hero__tagline" data-reveal style="--d:5">{person.tagline}</p>

      <a class="btn btn--primary" href={`${root}vcf/${person.slug}.vcf`} data-reveal data-haptic style="--d:6">
        <UserRoundPlus size={21} stroke-width={2.3} />
        <span>Rehbere Kaydet</span>
      </a>

      <ul class="actions">
        {
          actions.map((action, i) => {
            const Tag = action.href ? 'a' : 'button';
            return (
              <li data-reveal="pop" style={`--d:${7 + i}`}>
                <Tag
                  class:list={['action', `action--${action.key}`]}
                  href={action.href}
                  type={action.href ? undefined : 'button'}
                  target={action.href && action.external ? '_blank' : undefined}
                  rel={action.href && action.external ? 'noopener' : undefined}
                  data-pending={action.href ? undefined : ''}
                  data-haptic
                >
                  <span class="action__icon">
                    {action.key === 'call' && <Phone size={23} stroke-width={2} />}
                    {action.key === 'mail' && <Mail size={23} stroke-width={2} />}
                    {action.key === 'whatsapp' && (
                      <svg viewBox="0 0 24 24" width="23" height="23" fill="currentColor" aria-hidden="true">
                        <path d={siWhatsapp.path} />
                      </svg>
                    )}
                    {action.key === 'instagram' && (
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                        <path d={siInstagram.path} />
                      </svg>
                    )}
                  </span>
                  <span class="action__label">{action.label}</span>
                </Tag>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="hizmetler">
      <header class="section__head" data-reveal>
        <p class="eyebrow">Mağazamızda</p>
        <h2 id="hizmetler">Sizi neler bekliyor?</h2>
      </header>
      <ul class="tiles">
        {
          store.services.map((service, i) => {
            const Icon = serviceIcons[service.icon];
            return (
              <li class="tile" data-reveal style={`--d:${i}`}>
                <span class:list={['tile__icon', `tile__icon--${service.icon}`]}>
                  <Icon size={22} stroke-width={2} />
                </span>
                <h3>{service.title}</h3>
                <p>{service.text}</p>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="magaza">
      <header class="section__head" data-reveal>
        <p class="eyebrow">Bizi ziyaret edin</p>
        <h2 id="magaza">{store.mall}’deyiz</h2>
      </header>
      <StorePanel />
    </section>

    <section class="section" aria-labelledby="ekip">
      <header class="section__head" data-reveal>
        <p class="eyebrow">Ekibimiz</p>
        <h2 id="ekip">Ekip arkadaşlarım</h2>
      </header>
      <ul class="mates">
        {
          mates.map((mate, i) => (
            <li data-reveal style={`--d:${i}`}>
              <a class="mate" href={`${root}${mate.slug}/`}>
                <Monogram person={mate} size="sm" />
                <span class="mate__text">
                  <strong>{fullName(mate)}</strong>
                  <span>{mate.title}</span>
                </span>
                <ChevronRight size={20} stroke-width={2} />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <SiteFooter />
  </main>

  <dialog class="sheet" data-sheet aria-labelledby="sheet-title">
    <div class="sheet__inner">
      <span class="sheet__grabber" aria-hidden="true"></span>
      <button class="icon-btn sheet__close" type="button" data-close-sheet aria-label="Kapat">
        <X size={19} stroke-width={2} />
      </button>
      <p class="eyebrow">Dijital kartvizit</p>
      <h2 id="sheet-title">{name}</h2>
      <div class="qr-panel qr-panel--sheet" data-qr="./"></div>
      <p class="sheet__hint">Telefonun kamerasıyla okutun ya da bağlantıyı paylaşın.</p>
      <div class="sheet__actions">
        <button class="btn btn--primary" type="button" data-share data-haptic>
          <Share2 size={19} stroke-width={2.3} />
          <span>Paylaş</span>
        </button>
        <button class="btn btn--ghost" type="button" data-copy data-haptic>
          <Copy size={18} stroke-width={2.2} />
          <span>Bağlantıyı Kopyala</span>
        </button>
      </div>
    </div>
  </dialog>
</Base>
